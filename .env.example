# Local demo: temporary MongoDB is managed automatically.
# Required demo-only account. Set both values in .env; never commit credentials.
DEMO_USERNAME=
DEMO_PASSWORD=
MONGO_IN_MEMORY=true
# Required only with MONGO_IN_MEMORY=false; never commit a real connection string.
MONGO_URI=
# Docker Compose only: connection string for service mongo, database ncrflow, replica set rs0.
DOCKER_MONGO_URI=
PORT=4000
SEED_ON_START=true
STALE_NCR_DAYS=5
LOG_LEVEL=info
GRAPHIQL=true
# Enable when the public demo is served over HTTPS.
AUTH_COOKIE_SECURE=false
# Optional exact browser origin for a separately hosted frontend (no path).
FRONTEND_ORIGIN=
