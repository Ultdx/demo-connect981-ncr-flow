{
  "name": "@ncr-flow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "demo": "tsx --env-file-if-exists=../../.env demo.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx --env-file-if-exists=../../.env seed/seed.ts"
  },
  "dependencies": {
    "@typegoose/typegoose": "13.5.0",
    "dataloader": "^2.2.3",
    "graphql": "^16.11.0",
    "graphql-yoga": "^5.0.0",
    "inversify": "8.2.3",
    "mongodb-memory-server-core": "11.3.0",
    "mongoose": "~9.9.5",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0"
  }
}
