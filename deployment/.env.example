# Hosted API process. Copy to deployment/.env (ignored by Git).
# Required demo-only account. Set both values on the server; never commit credentials.
DEMO_USERNAME=
DEMO_PASSWORD=
PORT=9981
# Demo only: start temporary MongoDB automatically; reset all changes on API restart.
MONGO_IN_MEMORY=true
# For persistent storage, set MONGO_IN_MEMORY=false and provide MONGO_URI instead.
MONGO_URI=
FRONTEND_ORIGIN=https://example.com
AUTH_COOKIE_SECURE=true
GRAPHIQL=false
SEED_ON_START=true
LOG_LEVEL=info
